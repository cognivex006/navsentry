{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "NavSentry",
          "version": "0.2.0",
          "informationUri": "https://github.com/cognivex006/navsentry",
          "rules": [
            {
              "id": "NSC-AC-002",
              "name": "MissingauthenticationonAPIendpoint",
              "shortDescription": {
                "text": "Missing authentication on API endpoint"
              },
              "fullDescription": {
                "text": "An endpoint that returns non-public data responds 2xx to an anonymous actor."
              },
              "help": {
                "text": "Apply authentication middleware with deny-by-default to the whole API group; whitelist truly public routes explicitly."
              },
              "properties": {
                "tags": [
                  "CWE-306",
                  "A01:2025 Broken Access Control",
                  "A07:2025 Authentication Failures"
                ],
                "category": "AC",
                "priority": "IMMEDIATE"
              }
            },
            {
              "id": "NSC-AC-003",
              "name": "IDORBOLAcrossuserobjectaccess",
              "shortDescription": {
                "text": "IDOR / BOLA (cross-user object access)"
              },
              "fullDescription": {
                "text": "An actor can read or modify an object owned by another actor by changing an identifier, because ownership is not checked server-side."
              },
              "help": {
                "text": "Enforce ownership/tenant checks in the service layer for every object lookup; prefer scoped queries (WHERE owner_id = current_user)."
              },
              "properties": {
                "tags": [
                  "CWE-639",
                  "CWE-284",
                  "A01:2025 Broken Access Control"
                ],
                "category": "AC",
                "priority": "IMMEDIATE"
              }
            },
            {
              "id": "NSC-AC-007",
              "name": "Missingfunctionlevelauthorizationverticalprivilegeescalation",
              "shortDescription": {
                "text": "Missing function-level authorization (vertical privilege escalation)"
              },
              "fullDescription": {
                "text": "A lower-privileged authenticated actor receives the same 2xx contract as a privileged actor on a privileged function, because the server does not check the role or permission."
              },
              "help": {
                "text": "Enforce deny-by-default role/permission checks on the server for every privileged route or handler; do not rely on hidden menus."
              },
              "properties": {
                "tags": [
                  "CWE-285",
                  "CWE-862",
                  "A01:2025 Broken Access Control"
                ],
                "category": "AC",
                "priority": "IMMEDIATE"
              }
            },
            {
              "id": "NSC-PRIV-001",
              "name": "NationalIDpersonalidentifierdisclosure",
              "shortDescription": {
                "text": "National ID / personal identifier disclosure"
              },
              "fullDescription": {
                "text": "API or page responses contain 13-digit values that pass the Thai national ID checksum (or card numbers passing Luhn), exposing PII regulated by PDPA."
              },
              "help": {
                "text": "Remove or mask the field in the response DTO for unentitled callers; enforce field-level authorization server-side."
              },
              "properties": {
                "tags": [
                  "CWE-359",
                  "CWE-200",
                  "A01:2025 Broken Access Control",
                  "A04:2025 Cryptographic Failures"
                ],
                "category": "PRIV",
                "priority": "IMMEDIATE"
              }
            },
            {
              "id": "NSC-AC-004",
              "name": "PermissiveCORSpolicy",
              "shortDescription": {
                "text": "Permissive CORS policy"
              },
              "fullDescription": {
                "text": "The server reflects an arbitrary Origin (or 'null') in Access-Control-Allow-Origin, especially together with Access-Control-Allow-Credentials: true."
              },
              "help": {
                "text": "Replace origin reflection with an exact-match allowlist; never combine credentials with '*' or 'null'."
              },
              "properties": {
                "tags": [
                  "CWE-942",
                  "CWE-346",
                  "A01:2025 Broken Access Control",
                  "A02:2025 Security Misconfiguration"
                ],
                "category": "AC",
                "priority": "CAUTION"
              }
            },
            {
              "id": "NSC-CONF-002",
              "name": "ContentSecurityPolicymissingorunsafe",
              "shortDescription": {
                "text": "Content Security Policy missing or unsafe"
              },
              "fullDescription": {
                "text": "HTML responses have no enforcing Content-Security-Policy, or the policy allows 'unsafe-inline'/'unsafe-eval' scripts or wildcard script sources, so injected script is not contained."
              },
              "help": {
                "text": "Deploy Content-Security-Policy-Report-Only first, collect violations from real traffic, refactor inline scripts to nonces/hashes, then switch to the enforcing header."
              },
              "properties": {
                "tags": [
                  "CWE-693",
                  "CWE-1021",
                  "A02:2025 Security Misconfiguration",
                  "A05:2025 Injection"
                ],
                "category": "CONF",
                "priority": "CAUTION"
              }
            },
            {
              "id": "NSC-CRYPT-006",
              "name": "CleartextHTTPservedwithoutredirecttoHTTPS",
              "shortDescription": {
                "text": "Cleartext HTTP served without redirect to HTTPS"
              },
              "fullDescription": {
                "text": "An in-scope http:// origin serves application content instead of redirecting to HTTPS."
              },
              "help": {
                "text": "Redirect all HTTP to HTTPS at the edge; for internal service ports, enable TLS or restrict them to the internal network."
              },
              "properties": {
                "tags": [
                  "CWE-319",
                  "A04:2025 Cryptographic Failures"
                ],
                "category": "CRYPT",
                "priority": "IMMEDIATE"
              }
            },
            {
              "id": "NSC-ERR-001",
              "name": "Verboseerrorstacktraceorunhandledexceptionexposed",
              "shortDescription": {
                "text": "Verbose error, stack trace or unhandled exception exposed"
              },
              "fullDescription": {
                "text": "Error responses include stack traces, exception class names, SQL/ORM messages or framework error pages, leaking internals and indicating failing-open error handling."
              },
              "help": {
                "text": "Add a global exception handler that logs details server-side and returns a standard error envelope (e.g. RFC 9457 problem+json) without internals; disable framework detailed errors in non-dev environments."
              },
              "properties": {
                "tags": [
                  "CWE-209",
                  "CWE-248",
                  "CWE-550",
                  "A10:2025 Mishandling of Exceptional Conditions",
                  "A02:2025 Security Misconfiguration"
                ],
                "category": "ERR",
                "priority": "IMMEDIATE"
              }
            },
            {
              "id": "NSC-SESS-004",
              "name": "JWTmissingprotectionclaimsorweakalgorithm",
              "shortDescription": {
                "text": "JWT missing protection claims or weak algorithm"
              },
              "fullDescription": {
                "text": "Observed JWTs use alg 'none', omit exp, or lack audience/issuer binding, so tokens live forever or can be replayed to other services."
              },
              "help": {
                "text": "Issue tokens with exp/iat/aud/iss; validate them on every API; reject alg none and unexpected algorithms."
              },
              "properties": {
                "tags": [
                  "CWE-347",
                  "CWE-613",
                  "A07:2025 Authentication Failures",
                  "A04:2025 Cryptographic Failures"
                ],
                "category": "SESS",
                "priority": "PLANNED"
              }
            },
            {
              "id": "NSC-CONF-003",
              "name": "Clickjackingprotectionmissing",
              "shortDescription": {
                "text": "Clickjacking protection missing"
              },
              "fullDescription": {
                "text": "HTML responses can be framed by any origin: neither CSP frame-ancestors nor X-Frame-Options is set."
              },
              "help": {
                "text": "Send `Content-Security-Policy: frame-ancestors 'self' <approved-parents>` plus `X-Frame-Options: SAMEORIGIN` for legacy browsers."
              },
              "properties": {
                "tags": [
                  "CWE-1021",
                  "A02:2025 Security Misconfiguration"
                ],
                "category": "CONF",
                "priority": "CAUTION"
              }
            },
            {
              "id": "NSC-CONF-004",
              "name": "MIMEsniffingnotdisabledinsecureContentType",
              "shortDescription": {
                "text": "MIME sniffing not disabled / insecure Content-Type"
              },
              "fullDescription": {
                "text": "Responses with a body lack `X-Content-Type-Options: nosniff`, or omit Content-Type / charset, letting browsers guess the type."
              },
              "help": {
                "text": "Add `X-Content-Type-Options: nosniff` globally and make every handler set an accurate Content-Type (with charset for text)."
              },
              "properties": {
                "tags": [
                  "CWE-16",
                  "CWE-430",
                  "A02:2025 Security Misconfiguration"
                ],
                "category": "CONF",
                "priority": "PLANNED"
              }
            },
            {
              "id": "NSC-CONF-006",
              "name": "UnnecessaryHTTPmethodsormethodoverrideenabled",
              "shortDescription": {
                "text": "Unnecessary HTTP methods or method override enabled"
              },
              "fullDescription": {
                "text": "The server advertises (Allow / Access-Control-Allow-Methods) methods such as TRACE, TRACK, PUT or DELETE on resources that do not need them, or honours X-HTTP-Method-Override."
              },
              "help": {
                "text": "Restrict methods per route at the web server/framework; disable TRACE; remove method-override middleware unless strictly required."
              },
              "properties": {
                "tags": [
                  "CWE-650",
                  "CWE-16",
                  "A02:2025 Security Misconfiguration"
                ],
                "category": "CONF",
                "priority": "PLANNED"
              }
            },
            {
              "id": "NSC-CONF-007",
              "name": "Insecurecachepolicyforsensitiveresponses",
              "shortDescription": {
                "text": "Insecure cache policy for sensitive responses"
              },
              "fullDescription": {
                "text": "Authenticated or personal API/document responses are cacheable (no `Cache-Control: no-store`/`private`), so shared caches or the browser can retain them."
              },
              "help": {
                "text": "Add no-store on authenticated/sensitive routes (middleware by route group); keep long caching only for fingerprinted static assets."
              },
              "properties": {
                "tags": [
                  "CWE-524",
                  "CWE-525",
                  "A06:2025 Insecure Design",
                  "A02:2025 Security Misconfiguration"
                ],
                "category": "CONF",
                "priority": "PLANNED"
              }
            },
            {
              "id": "NSC-INFO-001",
              "name": "Serverframeworkversiondisclosure",
              "shortDescription": {
                "text": "Server / framework version disclosure"
              },
              "fullDescription": {
                "text": "Headers (Server, X-Powered-By, X-AspNet-Version, X-AspNetMvc-Version) or error pages reveal product versions, helping attackers pick exploits."
              },
              "help": {
                "text": "Remove/blank version headers at the server/proxy (e.g. server_tokens off, removeServerHeader, enableVersionHeader=false) and use custom error pages."
              },
              "properties": {
                "tags": [
                  "CWE-200",
                  "CWE-497",
                  "A02:2025 Security Misconfiguration"
                ],
                "category": "INFO",
                "priority": "PLANNED"
              }
            },
            {
              "id": "NSC-INFO-003",
              "name": "InternalIPaddressdisclosure",
              "shortDescription": {
                "text": "Internal IP address disclosure"
              },
              "fullDescription": {
                "text": "Response headers or bodies contain RFC 1918 / loopback / link-local addresses, revealing internal topology."
              },
              "help": {
                "text": "Stop echoing upstream addresses (Via, X-Backend-Server, error messages, config endpoints); configure the proxy to strip them."
              },
              "properties": {
                "tags": [
                  "CWE-200",
                  "A02:2025 Security Misconfiguration"
                ],
                "category": "INFO",
                "priority": "PLANNED"
              }
            },
            {
              "id": "NSC-SESS-002",
              "name": "CookiewithoutHttpOnlyflag",
              "shortDescription": {
                "text": "Cookie without HttpOnly flag"
              },
              "fullDescription": {
                "text": "Session-like cookies are readable by JavaScript (no HttpOnly), so any XSS can steal them."
              },
              "help": {
                "text": "Enable HttpOnly for session/auth cookies in the framework configuration."
              },
              "properties": {
                "tags": [
                  "CWE-1004",
                  "A02:2025 Security Misconfiguration",
                  "A07:2025 Authentication Failures"
                ],
                "category": "SESS",
                "priority": "CAUTION"
              }
            },
            {
              "id": "NSC-SESS-003",
              "name": "CookieSameSitemissingorcontradictory",
              "shortDescription": {
                "text": "Cookie SameSite missing or contradictory"
              },
              "fullDescription": {
                "text": "Cookies omit SameSite, or set SameSite=None without Secure (rejected by modern browsers), weakening CSRF defences."
              },
              "help": {
                "text": "Set SameSite=Lax by default; use None; Secure only for cookies that must travel cross-site (SSO, embedded apps)."
              },
              "properties": {
                "tags": [
                  "CWE-1275",
                  "CWE-352",
                  "A01:2025 Broken Access Control",
                  "A02:2025 Security Misconfiguration"
                ],
                "category": "SESS",
                "priority": "CAUTION"
              }
            },
            {
              "id": "NSC-INFO-004",
              "name": "Emailaddressdisclosure",
              "shortDescription": {
                "text": "Email address disclosure"
              },
              "fullDescription": {
                "text": "Responses expose email addresses (often staff/developer addresses in config or API payloads) that enable phishing and enumeration."
              },
              "help": {
                "text": "Remove addresses from config/diagnostic endpoints; return them only to authorized users who need them."
              },
              "properties": {
                "tags": [
                  "CWE-200",
                  "CWE-359",
                  "A01:2025 Broken Access Control"
                ],
                "category": "INFO",
                "priority": "PLANNED"
              }
            }
          ]
        }
      },
