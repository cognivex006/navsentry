{
  "manifest_version": 3,
  "name": "NavSentry Recorder",
  "version": "0.4.0",
  "description": "Record a user journey on a site you are authorized to test: steps and screenshots, never typed values. Saves a .navsentry recording for `navsentry flow from-recording`.",
  "minimum_chrome_version": "116",
  "action": { "default_title": "NavSentry Recorder", "default_popup": "popup.html" },
  "options_page": "options.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "unlimitedStorage", "scripting", "tabs", "downloads"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'none'" }
}
