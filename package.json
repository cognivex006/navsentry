{
  "name": "navsentry",
  "version": "0.1.0",
  "description": "AI-assisted browser-based E2E security testing for web applications, with automated vulnerability validation and evidence-based reporting.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "bin": {
    "navsentry": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/",
    "docs:catalog": "npm run build && node dist/scripts/gen-catalog-docs.js",
    "gate": "npm run build && node dist/scripts/local-gate.js"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
