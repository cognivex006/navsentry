{
  "name": "navsentry",
  "version": "0.3.1",
  "description": "AI-assisted browser-based E2E security testing for web applications, with automated vulnerability validation and evidence-based reporting.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "bin": {
    "navsentry": "dist/src/cli.js"
  },
  "files": [
    "dist/src/",
    "skills/",
    "docs/cases/",
    "docs/REPORTING.md",
    "docs/FLOWS.md",
    "docs/knowledge/",
    "examples/",
    ".claude-plugin/",
    ".codex-plugin/",
    ".antigravity-plugin/",
    "gemini-extension.json",
    "extension/",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/",
    "docs:catalog": "npm run build && node dist/scripts/gen-catalog-docs.js",
    "gate": "npm run build && node dist/scripts/local-gate.js",
    "release:pack": "npm run build && npm pack --pack-destination .navsentry/release",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "playwright-core": "1.64.1"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  }
}
